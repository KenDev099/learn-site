{
  "name": "cafe-api",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/unit/**/*.spec.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/**/*.spec.ts\"",
    "migrate": "node-pg-migrate up -m migrations",
    "ci": "npm run typecheck && npm test"
  },
  "dependencies": {
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
