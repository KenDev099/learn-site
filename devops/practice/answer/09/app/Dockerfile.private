# syntax=docker/dockerfile:1
# 建置時要從私有 registry 下載 @cafe/loyalty（scripts/fetch-private.mjs），需要 NPM_TOKEN
FROM node:24.22.2-alpine3.24
WORKDIR /app
COPY scripts ./scripts
# secret 只在這一個 RUN 期間以環境變數 NPM_TOKEN 出現，不會寫進任何一層，也不會進 history
RUN --mount=type=secret,id=npm_token,env=NPM_TOKEN node scripts/fetch-private.mjs
USER node
CMD ["node", "-p", "require('./vendor/cafe-loyalty.json')"]
