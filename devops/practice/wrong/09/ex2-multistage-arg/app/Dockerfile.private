# syntax=docker/dockerfile:1
# 錯誤：把 token 用名字不像機密的 build arg 傳進建置階段，最終階段只拿成果。
# 最終映像確實看不到，但 token 還在建置快取、--target 建出的中間映像和 provenance 裡
FROM node:24.22.2-alpine3.24 AS fetch
WORKDIR /app
COPY scripts ./scripts
ARG REG_CRED
RUN NPM_TOKEN=$REG_CRED node scripts/fetch-private.mjs

FROM node:24.22.2-alpine3.24
WORKDIR /app
COPY --from=fetch /app/vendor ./vendor
USER node
CMD ["node", "-p", "require('./vendor/cafe-loyalty.json')"]
