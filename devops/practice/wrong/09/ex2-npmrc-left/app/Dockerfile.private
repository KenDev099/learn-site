# syntax=docker/dockerfile:1
FROM node:24.22.2-alpine3.24
WORKDIR /app
COPY scripts ./scripts
RUN --mount=type=secret,id=npm_token,env=NPM_TOKEN \
  echo "//registry.npmjs.org/:_authToken=$NPM_TOKEN" > .npmrc && node scripts/fetch-private.mjs
USER node
CMD ["node", "-p", "require('./vendor/cafe-loyalty.json')"]
