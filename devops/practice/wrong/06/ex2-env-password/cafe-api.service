[Unit]
Description=Cafe API
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=cafe
Group=cafe
WorkingDirectory=/opt/cafe-api
Environment=APP_ENV=staging PORT=3000 DB_PASSWORD=espresso-7f3a91
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
