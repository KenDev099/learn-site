[Unit]
Description=Cafe API
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
WorkingDirectory=/opt/cafe-api
EnvironmentFile=/etc/cafe-api.env
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
