terraform {
  encryption {
    key_provider "pbkdf2" "main" {
      passphrase = "cafe-state-passphrase-2026"
    }
    method "aes_gcm" "main" {
      keys = key_provider.pbkdf2.main
    }
    state {
      method   = method.aes_gcm.main
      enforced = true
    }
    plan {
      method   = method.aes_gcm.main
      enforced = true
    }
  }
}
