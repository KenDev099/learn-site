; 練習 2：cafe.test 的 zone 檔
; 沒有以 . 結尾的名稱會自動接上 $ORIGIN：api 就是 api.cafe.test
$ORIGIN cafe.test.
$TTL 3600
@       IN SOA  ns1.cafe.test. admin.cafe.test. (
                2026110102 ; serial（序號）：每次修改都要加大
                7200       ; refresh
                3600       ; retry
                1209600    ; expire
                3600 )     ; minimum：「查不到」這個答案可以快取多久
@       IN NS   ns1.cafe.test.
ns1     IN A    10.0.1.53

; 在下面加上三筆紀錄
api     300 IN A     10.0.1.10
www     IN CNAME     api.cafe.test
@       IN TXT       "v=spf1 -all"
