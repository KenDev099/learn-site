From: =?UTF-8?q?=E5=B0=8F=E8=8A=B8?= <yun@cafe.example>
Date: Tue, 3 Nov 2026 16:20:00 +0800
Subject: [PATCH] =?UTF-8?q?feat(products):=20=E8=8F=9C=E5=96=AE=20API=20?=
 =?UTF-8?q?=E5=9B=9E=E5=82=B3=E5=95=86=E5=93=81=E5=88=86=E9=A1=9E?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

GET /products 多回 category（drink／food），前台分組顯示另開 CAFE-16。

Refs: CAFE-14
---
 .../migrations/20261103090000_products_category/migration.sql  | 2 ++
 api/prisma/schema.prisma                                       | 1 +
 api/prisma/seed.sql                                            | 3 +++
 api/src/products/products.module.ts                            | 2 +-
 4 files changed, 7 insertions(+), 1 deletion(-)
 create mode 100644 api/prisma/migrations/20261103090000_products_category/migration.sql

diff --git a/api/prisma/migrations/20261103090000_products_category/migration.sql b/api/prisma/migrations/20261103090000_products_category/migration.sql
new file mode 100644
index 0000000..ab56699
--- /dev/null
+++ b/api/prisma/migrations/20261103090000_products_category/migration.sql
@@ -0,0 +1,2 @@
+-- AlterTable
+ALTER TABLE "products" ADD COLUMN     "category" TEXT NOT NULL DEFAULT 'drink';
diff --git a/api/prisma/schema.prisma b/api/prisma/schema.prisma
index 708eac8..00cd063 100644
--- a/api/prisma/schema.prisma
+++ b/api/prisma/schema.prisma
@@ -14,6 +14,7 @@ model Product {
   price      Int
   available  Boolean     @default(true) // false＝下架：菜單上看不到
   legacySku  String?     @map("legacy_sku") // 舊 POS 系統的商品代碼，搬資料時留下來對帳用
+  category   String      @default("drink") // 菜單分類：drink（飲料）、food（餐點）
   orderItems OrderItem[]
 
   @@map("products")
diff --git a/api/prisma/seed.sql b/api/prisma/seed.sql
index 46b8827..a2efc38 100644
--- a/api/prisma/seed.sql
+++ b/api/prisma/seed.sql
@@ -9,6 +9,9 @@ INSERT INTO products (id, name, price, available) VALUES
   (7, '桂花烏龍（季節限定）', 100, false)
 ON CONFLICT (id) DO NOTHING;
 
+-- 菜單分類：預設是 drink，餐點另外標
+UPDATE products SET category = 'food' WHERE id IN (5, 6);
+
 -- 舊 POS 的商品代碼（搬資料時留下來的）
 UPDATE products SET legacy_sku = 'POS-' || lpad(id::text, 4, '0') WHERE legacy_sku IS NULL;
 
diff --git a/api/src/products/products.module.ts b/api/src/products/products.module.ts
index 1489499..7de79c0 100644
--- a/api/src/products/products.module.ts
+++ b/api/src/products/products.module.ts
@@ -9,7 +9,7 @@ export class ProductsService {
   menu() {
     return this.prisma.product.findMany({
       where: { available: true },
-      select: { id: true, name: true, price: true },
+      select: { id: true, name: true, price: true, category: true },
       orderBy: { id: 'asc' },
     })
   }
