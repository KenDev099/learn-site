[
  {
    "id": "AC1",
    "given": "顧客本人的訂單已經付好款（paid），吧台還沒開始製作",
    "when": "顧客按「取消訂單」並確認",
    "then": "訂單變成 cancelled；全額退款一次；付款送的點數用補償紀錄扣回；有預約時段的話空出一個名額",
    "examples": [
      {
        "status": "paid",
        "actorIsOwner": true,
        "expect": "refund"
      }
    ]
  },
  {
    "id": "AC2",
    "given": "訂單不是 paid：吧台已經開始製作（preparing），或還沒付款（pending）",
    "when": "顧客按「取消訂單」",
    "then": "拒絕（409 ORDER_NOT_CANCELLABLE），不退款；跟開始製作同時發生時只有一個成功",
    "examples": [
      {
        "status": "preparing",
        "actorIsOwner": true,
        "expect": "not_cancellable"
      },
      {
        "status": "pending",
        "actorIsOwner": true,
        "expect": "not_cancellable"
      }
    ]
  },
  {
    "id": "AC3",
    "given": "訂單是別的顧客的",
    "when": "顧客對它按取消",
    "then": "就像訂單不存在（404），不論訂單是什麼狀態",
    "examples": [
      {
        "status": "paid",
        "actorIsOwner": false,
        "expect": "not_found"
      },
      {
        "status": "preparing",
        "actorIsOwner": false,
        "expect": "not_found"
      }
    ]
  },
  {
    "id": "AC4",
    "given": "顧客本人的訂單已經取消了",
    "when": "再按一次取消（或同時按好幾次）",
    "then": "回目前的訂單（已取消），不顯示錯誤，也不再退款",
    "examples": [
      {
        "status": "cancelled",
        "actorIsOwner": true,
        "expect": "refund"
      }
    ]
  }
]