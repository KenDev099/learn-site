// Prisma Client 產生到 src/generated/prisma（不進 git）；連線網址在 prisma.config.ts
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  price      Int
  available  Boolean     @default(true) // false＝下架：菜單上看不到
  legacySku  String?     @map("legacy_sku") // 舊 POS 系統的商品代碼，搬資料時留下來對帳用
  orderItems OrderItem[]

  @@map("products")
}

model Customer {
  id           Int          @id @default(autoincrement())
  name         String
  orders       Order[]
  pointEntries PointEntry[]
  account      Account?

  @@map("customers")
}

model Order {
  id         Int         @id @default(autoincrement())
  customerId Int         @map("customer_id")
  customer   Customer    @relation(fields: [customerId], references: [id])
  status     String      @default("pending")
  total      Int
  note       String?
  orderedAt  DateTime    @default(now()) @map("ordered_at") @db.Timestamptz(3)
  pickupAt   DateTime?   @map("pickup_at") @db.Timestamptz(3) // 預約的取餐時間；NULL＝現點現做
  items      OrderItem[]
  payment    Payment?
  points     PointEntry[]

  @@index([customerId])
  @@index([status, orderedAt]) // 廚房看板：WHERE status IN (…) ORDER BY ordered_at
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Int     @map("unit_price")

  @@index([orderId])
  @@map("order_items")
}

// 每個取餐時段已經接了幾單：一個時段一列，第一次有人選這個時段時才建立
model PickupSlot {
  slotStart DateTime @id @map("slot_start") @db.Timestamptz(3) // 時段開始時間
  orders    Int      @default(0) // 已經接的單數，最多 10

  @@map("pickup_slots")
}

// 一張訂單一筆付款（CAFE-30）。status：pending（剛建立）、paid、failed、unknown（送出了但不知道結果）
model Payment {
  id         Int      @id @default(autoincrement())
  orderId    Int      @unique @map("order_id")
  order      Order    @relation(fields: [orderId], references: [id])
  status     String   @default("pending")
  amount     Int
  providerId String?  @map("provider_id") // CafePay 的付款編號（pay_…）
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)
  sdk        String   @default("v1") // 用哪一版 cafepay-sdk 送出：v1（1.4.2）或 v2（2.0.0）。重試、補單都照這一版

  @@map("payments")
}

// 點數的每一筆異動（只新增、不修改）。顧客的點數＝自己所有紀錄的 points 加總
model PointEntry {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])
  orderId    Int?     @map("order_id")
  order      Order?   @relation(fields: [orderId], references: [id])
  points     Int
  // order_paid：付款成功的回饋（每 10 元 1 點）；manual：店員手動調整；redeem：在櫃台兌換（負數，POS 寫入）
  // dup_reversal：資料修復寫入的補償紀錄（負數），抵銷 reversal_of 那一筆（CAFE-33）
  reason     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  reversalOf Int?        @unique @map("reversal_of") // 這筆抵銷的是哪一筆；一筆紀錄最多被抵銷一次
  reverses   PointEntry? @relation("Reversal", fields: [reversalOf], references: [id], onDelete: Restrict)
  reversedBy PointEntry? @relation("Reversal")
  runId      String?     @map("run_id") // 寫入這筆的資料修復批次（data_repair_runs.run_id）；一般的紀錄是 NULL

  @@index([customerId])
  @@index([orderId])
  @@map("point_entries")
}

// 處理過的 CafePay 通知（webhook）。event_id 是 CafePay 給的事件編號，重送時不會變
model ProcessedEvent {
  eventId    String   @id @map("event_id")
  type       String
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@map("processed_events")
}

// 資料修復的執行紀錄：一次執行一列，記錄做到哪裡（可續跑）與結果（CAFE-33）
model DataRepairRun {
  runId      String    @id @map("run_id") // 執行的人取的名字，例如 cafe33-1
  kind       String // 哪一種修復，例如 points-dedupe
  status     String // running（做到一半或正在做）、done、undone（已撤回）
  lastId     Int       @default(0) @map("last_id") // 游標：已經處理到哪一筆原始紀錄的 id
  reversed   Int       @default(0) // 寫了幾筆補償紀錄
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)

  @@map("data_repair_runs")
}

// 功能旗標：執行中決定走哪條程式路徑。percent＝開給幾 % 的對象（0～100），改這一列就生效，不用重新部署
// 改法：npm run flag -- <key> <percent>（scripts/flag.ts）
model FeatureFlag {
  key       String   @id
  percent   Int      @default(0)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("feature_flags")
}

// 登入帳號（v2.8.0，SEC-7）。role：customer（顧客，customerId 指到 customers）或 staff（店員，customerId 是 NULL）
// 密碼只存雜湊：scrypt$<salt>$<hash>（node:crypto 的 scrypt，見 api/src/auth/auth.module.ts）
model Account {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String    @map("password_hash")
  role         String
  customerId   Int?      @unique @map("customer_id")
  customer     Customer? @relation(fields: [customerId], references: [id])

  @@map("accounts")
}
