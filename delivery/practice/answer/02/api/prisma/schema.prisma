// Prisma Client 產生到 src/generated/prisma（不進 git）；連線網址在 prisma.config.ts
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  price      Int
  available  Boolean     @default(true) // false＝下架：菜單上看不到
  category   String      @default("drink") // 菜單分類：drink（飲料）、food（餐點）
  soldOut    Boolean     @default(false) @map("sold_out") // true＝今天賣完：菜單上看得到，但不能加入購物車
  orderItems OrderItem[]

  @@map("products")
}

model Customer {
  id     Int     @id @default(autoincrement())
  name   String
  orders Order[]

  @@map("customers")
}

model Order {
  id         Int         @id @default(autoincrement())
  customerId Int         @map("customer_id")
  customer   Customer    @relation(fields: [customerId], references: [id])
  status     String      @default("pending")
  total      Int
  note       String?
  orderedAt  DateTime    @default(now()) @map("ordered_at") @db.Timestamptz(3)
  items      OrderItem[]

  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Int     @map("unit_price")

  @@index([orderId])
  @@map("order_items")
}
