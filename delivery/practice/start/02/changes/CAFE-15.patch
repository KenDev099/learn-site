@@ -23,7 +23,8 @@ onMounted(async () => {
   <ul>
     <li v-for="p in products" :key="p.id">
       {{ p.name }} {{ p.price }} 元
-      <button type="button" @click="cart.add(p)">加入</button>
+      <span v-if="p.soldOut">（已售完）</span>
+      <button type="button" :disabled="p.soldOut" @click="cart.add(p)">加入</button>
     </li>
   </ul>
 </template>
