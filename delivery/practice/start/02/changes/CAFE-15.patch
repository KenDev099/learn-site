CAFE-15 商品可以標「已售完」

作者：阿哲（分支 cafe-15-sold-out）

店員可以把今天賣完的商品標成售完：菜單上還看得到，名稱旁顯示「已售完」，不能加入購物車。
順便刪掉已經沒有程式在讀的 products.legacy_sku（舊 POS 系統的商品代碼）。

---
diff --git a/api/prisma/migrations/20261104000000_sold_out/migration.sql b/api/prisma/migrations/20261104000000_sold_out/migration.sql
new file mode 100644
index 0000000..39bbc35
--- /dev/null
+++ b/api/prisma/migrations/20261104000000_sold_out/migration.sql
@@ -0,0 +1,3 @@
+-- AlterTable
+ALTER TABLE "products" DROP COLUMN "legacy_sku",
+ADD COLUMN     "sold_out" BOOLEAN NOT NULL DEFAULT false;
diff --git a/api/prisma/schema.prisma b/api/prisma/schema.prisma
index 708eac8..e7c55cd 100644
--- a/api/prisma/schema.prisma
+++ b/api/prisma/schema.prisma
@@ -13,7 +13,7 @@ model Product {
   name       String      @unique
   price      Int
   available  Boolean     @default(true) // false＝下架：菜單上看不到
-  legacySku  String?     @map("legacy_sku") // 舊 POS 系統的商品代碼，搬資料時留下來對帳用
+  soldOut    Boolean     @default(false) @map("sold_out") // true＝今天賣完：菜單上看得到，但不能加入購物車
   orderItems OrderItem[]
 
   @@map("products")
diff --git a/api/prisma/seed.sql b/api/prisma/seed.sql
index 46b8827..3451c50 100644
--- a/api/prisma/seed.sql
+++ b/api/prisma/seed.sql
@@ -9,9 +9,6 @@ INSERT INTO products (id, name, price, available) VALUES
   (7, '桂花烏龍（季節限定）', 100, false)
 ON CONFLICT (id) DO NOTHING;
 
--- 舊 POS 的商品代碼（搬資料時留下來的）
-UPDATE products SET legacy_sku = 'POS-' || lpad(id::text, 4, '0') WHERE legacy_sku IS NULL;
-
 INSERT INTO customers (id, name) VALUES
   (1, '王小明'), (2, '陳美華'), (3, '林志豪'), (4, '張雅婷'), (5, '李建國'), (6, '黃淑芬')
 ON CONFLICT (id) DO NOTHING;
diff --git a/api/src/products/products.module.ts b/api/src/products/products.module.ts
index 1489499..edee9a8 100644
--- a/api/src/products/products.module.ts
+++ b/api/src/products/products.module.ts
@@ -1,18 +1,32 @@
-import { Controller, Get, Injectable, Module } from '@nestjs/common'
+import { Body, Controller, Get, Injectable, Module, Param, ParseIntPipe, Patch } from '@nestjs/common'
+import { IsBoolean } from 'class-validator'
 import { PrismaService } from '../common/prisma.service.js'
 
+export class SoldOutDto {
+  @IsBoolean()
+  soldOut: boolean
+}
+
 @Injectable()
 export class ProductsService {
   constructor(private readonly prisma: PrismaService) {}
 
-  // 菜單：只列出還在賣的商品
+  // 菜單：只列出還在賣的商品（售完的也列出來，畫面上標「已售完」）
   menu() {
     return this.prisma.product.findMany({
       where: { available: true },
-      select: { id: true, name: true, price: true },
+      select: { id: true, name: true, price: true, soldOut: true },
       orderBy: { id: 'asc' },
     })
   }
+
+  setSoldOut(id: number, soldOut: boolean) {
+    return this.prisma.product.update({
+      where: { id },
+      data: { soldOut },
+      select: { id: true, name: true, price: true, soldOut: true },
+    })
+  }
 }
 
 @Controller('products')
@@ -23,6 +37,12 @@ export class ProductsController {
   menu() {
     return this.products.menu()
   }
+
+  // 店員標記售完／恢復供應
+  @Patch(':id/sold-out')
+  setSoldOut(@Param('id', ParseIntPipe) id: number, @Body() body: SoldOutDto) {
+    return this.products.setSoldOut(id, body.soldOut)
+  }
 }
 
 @Module({ controllers: [ProductsController], providers: [ProductsService] })
diff --git a/web/src/api/products.ts b/web/src/api/products.ts
index 7581976..1352acc 100644
--- a/web/src/api/products.ts
+++ b/web/src/api/products.ts
@@ -4,6 +4,7 @@ export interface Product {
   id: number
   name: string
   price: number
+  soldOut: boolean
 }
 
 export const listProducts = () => api<Product[]>('/products')
diff --git a/web/src/pages/MenuPage.vue b/web/src/pages/MenuPage.vue
index 0b75ebf..7f64fa9 100644
--- a/web/src/pages/MenuPage.vue
