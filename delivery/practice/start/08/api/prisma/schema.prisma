// Prisma Client 產生到 src/generated/prisma（不進 git）；連線網址在 prisma.config.ts
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  price      Int
  available  Boolean     @default(true) // false＝下架：菜單上看不到
  legacySku  String?     @map("legacy_sku") // 舊 POS 系統的商品代碼，搬資料時留下來對帳用
  orderItems OrderItem[]

  @@map("products")
}

model Customer {
  id           Int          @id @default(autoincrement())
  name         String
  orders       Order[]
  pointEntries PointEntry[]

  @@map("customers")
}

model Order {
  id         Int         @id @default(autoincrement())
  customerId Int         @map("customer_id")
  customer   Customer    @relation(fields: [customerId], references: [id])
  status     String      @default("pending")
  total      Int
  note       String?
  orderedAt  DateTime    @default(now()) @map("ordered_at") @db.Timestamptz(3)
  pickupAt   DateTime?   @map("pickup_at") @db.Timestamptz(3) // 預約的取餐時間；NULL＝現點現做
  items      OrderItem[]
  payment    Payment?
  points     PointEntry[]

  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Int     @map("unit_price")

  @@index([orderId])
  @@map("order_items")
}

// 每個取餐時段已經接了幾單：一個時段一列，第一次有人選這個時段時才建立
model PickupSlot {
  slotStart DateTime @id @map("slot_start") @db.Timestamptz(3) // 時段開始時間
  orders    Int      @default(0) // 已經接的單數，最多 10

  @@map("pickup_slots")
}

// 一張訂單一筆付款（CAFE-30）。status：pending（剛建立）、paid、failed、unknown（送出了但不知道結果）
model Payment {
  id         Int      @id @default(autoincrement())
  orderId    Int      @unique @map("order_id")
  order      Order    @relation(fields: [orderId], references: [id])
  status     String   @default("pending")
  amount     Int
  providerId String?  @map("provider_id") // CafePay 的付款編號（pay_…）
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)

  @@map("payments")
}

// 點數的每一筆異動（只新增、不修改）。顧客的點數＝自己所有紀錄的 points 加總
model PointEntry {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])
  orderId    Int?     @map("order_id")
  order      Order?   @relation(fields: [orderId], references: [id])
  points     Int
  reason     String // order_paid：付款成功的回饋（每 10 元 1 點）；manual：店員手動調整
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([customerId])
  @@index([orderId])
  @@map("point_entries")
}

// 處理過的 CafePay 通知（webhook）。event_id 是 CafePay 給的事件編號，重送時不會變
model ProcessedEvent {
  eventId    String   @id @map("event_id")
  type       String
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@map("processed_events")
}
