generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 租戶本身與使用者是全域的表（沒有 tenant_id、沒有 RLS）；其他有 tenant_id 的表都開 RLS（第 9 課，見 migration）

model Tenant {
  id        String   @id @db.Uuid
  name      String
  plan      String   @default("free") // free、pro（第 14 課）
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("tenants")
}

// email 全域唯一（存小寫）；角色不放這裡，放在 membership：同一個人在不同租戶可以是不同角色（第 7 課）
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("users")
}

model Membership {
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String // owner、admin、member、viewer
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

// refresh token 只存雜湊；同一次登入換出來的是同一個家族（第 7 課）
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([familyId])
  @@map("refresh_tokens")
}

model Invitation {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  email      String
  role       String
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String    @map("invited_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([tenantId])
  @@map("invitations")
}

// 示範模組。@@unique([tenantId, id]) 讓子表可以用 (tenant_id, project_id) 複合外鍵參照（第 8 課）
model Project {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  description String    @default("")
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  files       File[]

  @@unique([tenantId, id])
  @@index([tenantId, createdAt, id])
  @@map("projects")
}

// 第二個示範的業務模組：只有名稱，給第 18 課的 BOLA 探針用
model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId])
  @@map("tags")
}

model File {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  project     Project  @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  filename    String
  contentType String   @map("content_type")
  size        Int
  storageKey  String   @map("storage_key")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId])
  @@map("files")
}

model Export {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  type        String
  status      String    @default("queued") // queued、running、done、failed
  error       String?
  storageKey  String?   @map("storage_key")
  rowCount    Int?      @map("row_count")
  requestedBy String    @map("requested_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(3)

  @@index([tenantId])
  @@map("exports")
}

// 只能追加：pf_app 沒有 UPDATE、DELETE 權限（第 11 課，見 migration）
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  requestId  String   @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt, id])
  @@map("audit_logs")
}
