generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 活動：remaining 是剩下的名額，報名時用條件式 UPDATE 扣（第 2 課）
// capacity、remaining 的範圍由 migration 裡手寫的 CHECK 擋（Prisma schema 寫不出 CHECK）
model Event {
  id            String         @id @default(uuid()) @db.Uuid
  title         String
  startsAt      DateTime       @map("starts_at") @db.Timestamptz(3)
  capacity      Int
  remaining     Int
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  registrations Registration[]

  @@index([startsAt, id])
  @@map("events")
}

// email 存成小寫：同一個活動不能用同一個 email 報名兩次（大小寫不同也算同一個）
model Registration {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email     String
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([eventId, email])
  @@map("registrations")
}
