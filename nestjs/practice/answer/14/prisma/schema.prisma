// Prisma 7：Prisma Client 產生到 src/generated/prisma（不進 git），連線網址寫在 prisma.config.ts
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       Int       @id @default(autoincrement())
  // 程式與 API 叫 title，資料表欄位還是 name：不用 migration，舊版程式照常執行
  title    String    @unique @map("name")
  products Product[]

  @@map("categories")
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  price       Int
  costPrice   Int         @default(0) @map("cost_price") // 成本：只給店內看，不能出現在 API 回應
  isAvailable Boolean     @default(true) @map("is_available")
  categoryId  Int         @map("category_id")
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  orderItems  OrderItem[]

  @@map("products")
}

model Customer {
  id     Int     @id @default(autoincrement())
  name   String
  phone  String  @unique
  orders Order[]

  @@map("customers")
}

model Order {
  id         Int         @id @default(autoincrement())
  customerId Int         @map("customer_id")
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status     String      @default("pending")
  total      Int
  orderedAt  DateTime    @default(now()) @map("ordered_at") @db.Timestamptz(3)
  items      OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Int     @map("unit_price") // 下單當下的單價：商品之後漲價，這筆訂單也不變

  @@map("order_items")
}
