// Prisma 7：Prisma Client 產生到 src/generated/prisma（不進 git），連線網址寫在 prisma.config.ts
// 練習 3：WebhookEvent.eventId 加上唯一約束（npx prisma migrate dev --name webhook-event-unique）
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending
  paid

  @@map("order_status")
}

model Product {
  id       Int     @id @default(autoincrement())
  name     String
  price    Int
  imageUrl String? @map("image_url") // 例如 /uploads/3f2c….png；null 代表還沒有圖

  @@map("products")
}

model Order {
  id     Int         @id @default(autoincrement())
  total  Int
  status OrderStatus @default(pending)
  paidAt DateTime?   @map("paid_at") @db.Timestamptz(3)

  @@map("orders")
}

// 收到的每一個 webhook 事件都記一筆：status 是 'processed'（有改到訂單）或 'ignored'（找不到可以付款的訂單）
model WebhookEvent {
  id         Int      @id @default(autoincrement())
  eventId    String   @unique @map("event_id") // 金流公司給的事件 id，例如 evt_1；重送時不變。唯一約束讓重複的事件寫不進來
  type       String
  status     String
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@map("webhook_events")
}
