// Prisma 7：Prisma Client 產生到 src/generated/prisma（不進 git），連線網址寫在 prisma.config.ts
// 期末專題的十張表都已經建好（prisma/migrations），不用改 schema
// 資料歸屬（第 26 課）：categories、products → catalog；customers、orders、order_items、idempotency_keys → orders；
//   webhook_events → payments；stamp_cards、point_transactions → loyalty；outbox_events → outbox
// CHECK 約束 Prisma 寫不出來，直接寫在 migration.sql 裡（第 13 課）
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending
  paid
  preparing
  ready
  completed
  cancelled

  @@map("order_status")
}

model Customer {
  id        Int         @id @default(autoincrement())
  name      String
  email     String      @unique
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  orders    Order[]
  card      StampCard?

  @@map("customers")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id         Int         @id @default(autoincrement())
  categoryId Int         @map("category_id")
  category   Category    @relation(fields: [categoryId], references: [id])
  name       String
  price      Int // CHECK (price >= 0)
  stock      Int // CHECK (stock >= 0)：條件更新之外的最後一道防線，不會賣超
  active     Boolean     @default(true)
  items      OrderItem[]

  @@index([categoryId])
  @@map("products")
}

model Order {
  id         Int         @id @default(autoincrement())
  customerId Int         @map("customer_id")
  customer   Customer    @relation(fields: [customerId], references: [id])
  status     OrderStatus @default(pending)
  total      Int // CHECK (total >= 0)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  paidAt     DateTime?   @map("paid_at") @db.Timestamptz(3)
  items      OrderItem[]

  @@index([customerId, id]) // 顧客的訂單紀錄：WHERE customer_id = ? ORDER BY id（cursor 分頁，第 16 課）
  @@map("orders")
}

// 下單當下的品名與單價存一份快照（第 15 課）：之後商品改名、改價，舊訂單不變
model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  name      String
  unitPrice Int     @map("unit_price") // CHECK (unit_price >= 0)
  quantity  Int // CHECK (quantity > 0)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model StampCard {
  id           Int                @id @default(autoincrement())
  customerId   Int                @unique @map("customer_id")
  customer     Customer           @relation(fields: [customerId], references: [id])
  transactions PointTransaction[]

  @@map("stamp_cards")
}

// 點數明細：餘額 = SUM(points)。同一張訂單只能加一次點（order_id 唯一）
model PointTransaction {
  id        Int       @id @default(autoincrement())
  cardId    Int       @map("card_id")
  card      StampCard @relation(fields: [cardId], references: [id])
  orderId   Int?      @unique @map("order_id")
  points    Int // CHECK (points <> 0)：負數是兌換
  reason    String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([cardId])
  @@map("point_transactions")
}

// 收到的每一個金流 webhook 事件；event_id 唯一，重送的事件寫不進來（第 22 課）
model WebhookEvent {
  id         Int      @id @default(autoincrement())
  eventId    String   @unique @map("event_id")
  type       String
  status     String // processed：改到訂單；ignored：訂單不是待付款
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@map("webhook_events")
}

// Idempotency-Key：同一個 key 只會真的處理一次，之後重送都回傳存下來的第一次回應
model IdempotencyKey {
  key            String   @id
  requestHash    String   @map("request_hash") // 請求內容的 SHA-256：同一個 key 配不同的內容 → 422
  responseStatus Int?     @map("response_status")
  responseBody   String?  @map("response_body") // 存原始字串（text）：jsonb 會重排 key，重送的內容就不會一字不差
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt]) // 定期刪掉超過保存期限的 key
  @@map("idempotency_keys")
}

// transactional outbox（第 20 課）：跟業務資料在同一個交易裡寫入「要送出的訊息」，再由 OutboxRelay 送進佇列
model OutboxEvent {
  id          Int       @id @default(autoincrement())
  type        String // order.paid、receipt.requested
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([publishedAt, id])
  @@map("outbox_events")
}
