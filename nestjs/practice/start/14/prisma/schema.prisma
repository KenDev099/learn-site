// Prisma 7：Prisma Client 產生到 src/generated/prisma（不進 git），連線網址寫在 prisma.config.ts
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       Int       @id @default(autoincrement())
  // 練習 5：程式與 API 改叫 title，資料表欄位維持 name
  name     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  price       Int
  costPrice   Int      @default(0) @map("cost_price") // 成本：只給店內看，不能出現在 API 回應
  isAvailable Boolean  @default(true) @map("is_available")
  categoryId  Int      @map("category_id")
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("products")
}

model Customer {
  id     Int     @id @default(autoincrement())
  name   String
  phone  String  @unique
  orders Order[]

  @@map("customers")
}

model Order {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status     String   @default("pending")
  total      Int
  orderedAt  DateTime @default(now()) @map("ordered_at") @db.Timestamptz(3)

  @@map("orders")
}

// 練習 3：在這裡寫 OrderItem（資料表 order_items），並在 Order、Product 加上反向的關聯欄位
