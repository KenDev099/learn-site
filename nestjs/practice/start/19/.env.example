# 本機開發用的設定範本：第一次執行 node check.mjs 時會複製成 .env（.env 不進 git）
# 開發用資料庫 nest_19：npx prisma migrate deploy 會套用 prisma/migrations。判分用的是另一個資料庫 nest_19_test，由 check.mjs 重建
NODE_ENV=development
PORT=3100
DATABASE_URL=postgresql://learn:learn@127.0.0.1:5433/nest_19
# 開發用 Redis DB 0；判分用 DB 1，key 的前綴是 nest-19-test
REDIS_URL=redis://127.0.0.1:6380/0
REDIS_PREFIX=nest-19
