// Prisma 7：Prisma Client 產生到 src/generated/prisma（不進 git），連線網址寫在 prisma.config.ts
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  price    Int
  category String  // coffee、tea、food
  active   Boolean @default(true)   // false：停售，菜單上不顯示

  @@map("products")
}

model Customer {
  id     Int     @id @default(autoincrement())
  name   String
  phone  String  @unique
  orders Order[]

  @@map("customers")
}

model Order {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  total      Int
  orderedAt  DateTime @default(now()) @map("ordered_at") @db.Timestamptz(3)

  @@index([customerId, orderedAt])
  @@map("orders")
}
