// Prisma 7：Prisma Client 產生到 src/generated/prisma（不進 git），連線網址寫在 prisma.config.ts
// 這一課的資料表已經建好（prisma/migrations），不用改 schema
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending
  paid
  preparing
  ready
  completed
  cancelled

  @@map("order_status")
}

model Customer {
  id     Int     @id @default(autoincrement())
  name   String
  email  String
  orders Order[]

  @@map("customers")
}

model Order {
  id            Int         @id @default(autoincrement())
  customerId    Int         @map("customer_id")
  customer      Customer    @relation(fields: [customerId], references: [id])
  total         Int
  status        OrderStatus @default(pending)
  receiptSentAt DateTime?   @map("receipt_sent_at") @db.Timestamptz(3) // 收據寄出的時間；null 代表還沒寄
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([customerId])
  @@map("orders")
}

// transactional outbox：跟訂單在同一個交易裡寫入「要送出的訊息」，再由 OutboxRelay 送進佇列
model OutboxEvent {
  id          Int       @id @default(autoincrement())
  type        String // 例如 'receipt.requested'
  payload     Json // 例如 { "orderId": 1 }
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3) // null 代表還沒送進佇列

  @@index([publishedAt, id])
  @@map("outbox_events")
}
