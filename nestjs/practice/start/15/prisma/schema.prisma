// Prisma 7：Prisma Client 產生到 src/generated/prisma（不進 git），連線網址寫在 prisma.config.ts
// 這一課的資料表已經建好（prisma/migrations），不用改 schema
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  price      Int
  stock      Int         @default(0)
  version    Int         @default(1) // 樂觀鎖：每次改價格就 + 1
  orderItems OrderItem[]

  @@map("products")
}

model Order {
  id        Int         @id @default(autoincrement())
  total     Int
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  items     OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Int     @map("unit_price") // 下單當下的單價（第 14 課）

  @@map("order_items")
}

model StampCard {
  id           Int                @id @default(autoincrement())
  customerName String             @map("customer_name")
  transactions PointTransaction[]

  @@map("stamp_cards")
}

// 集點卡的每一筆加點（正數）與兌換（負數）；餘額＝加總（PostgreSQL 課第 26 課的設計）
model PointTransaction {
  id        Int       @id @default(autoincrement())
  cardId    Int       @map("card_id")
  card      StampCard @relation(fields: [cardId], references: [id])
  points    Int
  reason    String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([cardId])
  @@map("point_transactions")
}
