// Prisma 7：Prisma Client 產生到 src/generated/prisma（不進 git），連線網址寫在 prisma.config.ts
// 這一課的資料表已經建好（prisma/migrations），不用改 schema
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending
  paid
  preparing
  ready
  completed
  cancelled

  @@map("order_status")
}

model Customer {
  id        Int        @id @default(autoincrement())
  name      String
  orders    Order[]
  stampCard StampCard?

  @@map("customers")
}

model Order {
  id         Int         @id @default(autoincrement())
  customerId Int         @map("customer_id")
  customer   Customer    @relation(fields: [customerId], references: [id])
  total      Int
  status     OrderStatus @default(pending)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([customerId])
  @@map("orders")
}

// 一位顧客最多一張集點卡（customer_id 唯一）
model StampCard {
  id           Int                @id @default(autoincrement())
  customerId   Int                @unique @map("customer_id")
  customer     Customer           @relation(fields: [customerId], references: [id])
  transactions PointTransaction[]

  @@map("stamp_cards")
}

// 集點卡的每一筆加點（正數）與兌換（負數）；餘額＝加總
model PointTransaction {
  id        Int       @id @default(autoincrement())
  cardId    Int       @map("card_id")
  card      StampCard @relation(fields: [cardId], references: [id])
  points    Int
  reason    String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([cardId])
  @@map("point_transactions")
}
