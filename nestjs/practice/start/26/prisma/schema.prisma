// Prisma 7：Prisma Client 產生到 src/generated/prisma（不進 git），連線網址寫在 prisma.config.ts
// 這一課的資料表已經建好（prisma/migrations），不用改 schema
// 每張表屬於一個模組（資料歸屬）：products → catalog；orders、order_items → orders；stamp_cards、point_transactions → loyalty
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending
  paid

  @@map("order_status")
}

// catalog 的表
model Product {
  id    Int    @id @default(autoincrement())
  name  String
  price Int

  @@map("products")
}

// orders 的表。customer_id 只是一個數字：這一課沒有 customers 模組
model Order {
  id         Int         @id @default(autoincrement())
  customerId Int         @map("customer_id")
  total      Int
  status     OrderStatus @default(pending)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  items      OrderItem[]

  @@map("orders")
}

// 下單當下的品名與單價存一份快照：之後商品改名、改價，舊訂單不變，orders 也不必去查 products
model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   Int    @map("order_id")
  order     Order  @relation(fields: [orderId], references: [id])
  productId Int    @map("product_id")
  name      String
  unitPrice Int    @map("unit_price")
  quantity  Int

  @@index([orderId])
  @@map("order_items")
}

// loyalty 的表：一位顧客一張集點卡
model StampCard {
  id           Int                @id @default(autoincrement())
  customerId   Int                @unique @map("customer_id")
  transactions PointTransaction[]

  @@map("stamp_cards")
}

// 每一筆加點；同一張訂單只加一次（order_id 唯一）
model PointTransaction {
  id        Int       @id @default(autoincrement())
  cardId    Int       @map("card_id")
  card      StampCard @relation(fields: [cardId], references: [id])
  orderId   Int?      @unique @map("order_id")
  points    Int
  reason    String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([cardId])
  @@map("point_transactions")
}
