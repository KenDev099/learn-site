# 本機開發用的設定範本：第一次執行 node check.mjs 時會複製成 .env（.env 不進 git）
# 開發用資料庫 nest_22：npx prisma migrate dev 會建立它並套用 prisma/migrations。判分用的是另一個資料庫 nest_22_test，由 check.mjs 重建
NODE_ENV=development
PORT=3100
DATABASE_URL=postgresql://learn:learn@127.0.0.1:5433/nest_22
# 金流公司後台給的 webhook 密鑰：只存在伺服器的設定裡，不進 git、不寫在程式碼
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret-change-me
# 上傳的圖片存在這裡（相對於啟動時的資料夾）
UPLOAD_DIR=uploads
