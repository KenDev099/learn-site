// Prisma 7：Prisma Client 產生到 src/generated/prisma（不進 git），連線網址寫在 prisma.config.ts
// 這一課的資料表已經建好（prisma/migrations），不用改 schema
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending
  paid
  preparing
  ready
  completed
  cancelled

  @@map("order_status")
}

enum PaymentStatus {
  succeeded
  failed

  @@map("payment_status")
}

model Customer {
  id        Int        @id @default(autoincrement())
  name      String
  orders    Order[]
  stampCard StampCard?

  @@map("customers")
}

model Order {
  id         Int         @id @default(autoincrement())
  customerId Int         @map("customer_id")
  customer   Customer    @relation(fields: [customerId], references: [id])
  total      Int
  status     OrderStatus @default(pending)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  payments   Payment[]

  @@index([customerId])
  @@map("orders")
}

// 一位顧客最多一張集點卡（customer_id 唯一）
model StampCard {
  id           Int                @id @default(autoincrement())
  customerId   Int                @unique @map("customer_id")
  customer     Customer           @relation(fields: [customerId], references: [id])
  transactions PointTransaction[]

  @@map("stamp_cards")
}

// 集點卡的每一筆加點（正數）與兌換（負數）；餘額＝加總
model PointTransaction {
  id        Int       @id @default(autoincrement())
  cardId    Int       @map("card_id")
  card      StampCard @relation(fields: [cardId], references: [id])
  points    Int
  reason    String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([cardId])
  @@map("point_transactions")
}

// 金流公司回報的付款紀錄：一張訂單可能有失敗後又成功的好幾筆（練習 3 的對帳拿它和 orders 比對）
model Payment {
  id        Int           @id @default(autoincrement())
  orderId   Int           @map("order_id")
  order     Order         @relation(fields: [orderId], references: [id])
  amount    Int
  status    PaymentStatus
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([orderId])
  @@map("payments")
}

// 對帳自動修正的紀錄：同一張訂單、同一種修正只能有一筆（重跑不會重複）
model ReconciliationFix {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  kind      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([orderId, kind])
  @@map("reconciliation_fixes")
}

// 批次工作的檢查點：name 是工作名稱，cursor 是最後處理完的訂單 id
model JobCheckpoint {
  name      String   @id
  cursor    Int
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("job_checkpoints")
}

// 廚房看板的通知：付款後由 KitchenListener 新增（練習 4）
model KitchenNotice {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("kitchen_notices")
}

// 每天的營業統計：day 是台北時間的日期，例如 '2026-11-01'（練習 5）
model DailyStats {
  day     String @id
  orders  Int
  revenue Int

  @@map("daily_stats")
}
