generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 租戶 = 品牌。同一個平台上有好幾個咖啡品牌，彼此的資料不能互相看到（第 20 課）
model Tenant {
  id       Int       @id @default(autoincrement())
  name     String
  stores   Store[]
  users    User[]
  products Product[]

  @@map("tenants")
}

model Store {
  id       Int     @id @default(autoincrement())
  tenantId Int     @map("tenant_id")
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  name     String
  orders   Order[]
  users    User[]

  @@index([tenantId])
  @@map("stores")
}

// 顧客、店員（barista）、店長（manager）都是 User。店員與顧客有 storeId（所屬門市、常去門市），店長管整個租戶
model User {
  id             Int             @id @default(autoincrement())
  tenantId       Int             @map("tenant_id")
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  storeId        Int?            @map("store_id")
  store          Store?          @relation(fields: [storeId], references: [id])
  email          String          @unique
  passwordHash   String          @map("password_hash")
  role           String // customer、barista、manager
  name           String
  phone          String?
  points         Int             @default(0)
  mfaSecret      String?         @map("mfa_secret")
  tokenVersion   Int             @default(0) @map("token_version")
  disabledAt     DateTime?       @map("disabled_at")
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  orders         Order[]

  @@index([tenantId])
  @@map("users")
}

model Order {
  id         Int      @id @default(autoincrement())
  storeId    Int      @map("store_id")
  store      Store    @relation(fields: [storeId], references: [id])
  customerId Int      @map("customer_id")
  customer   User     @relation(fields: [customerId], references: [id])
  total      Int
  status     String   @default("pending")
  orderedAt  DateTime @default(now()) @map("ordered_at")

  @@index([storeId])
  @@map("orders")
}

model Product {
  id       Int     @id @default(autoincrement())
  tenantId Int     @map("tenant_id")
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  name     String
  price    Int
  imageUrl String? @map("image_url")

  @@unique([tenantId, name]) // 同一個品牌的商品不能同名
  @@map("products")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  familyId  String    @map("family_id")
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  @@index([userId])
  @@map("password_resets")
}
