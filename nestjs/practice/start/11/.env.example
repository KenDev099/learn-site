# 本機開發用的設定範本：列出需要哪些變數，只放假值，可以 commit
# 第一次執行 node check.mjs 時會複製成 .env；.env 不進 git，真正的 secret 只放在部署平台
NODE_ENV=development
PORT=3100
DATABASE_URL=postgresql://learn:learn@127.0.0.1:5433/nest_11
CORS_ORIGINS=http://localhost:5173
ORDER_MAX_ITEMS=20
FEATURE_STAMPS=true
PAYMENT_BASE_URL=https://sandbox.pay.example.test
# PAYMENT_API_KEY 在 production 必填，由部署平台注入；本機不需要
