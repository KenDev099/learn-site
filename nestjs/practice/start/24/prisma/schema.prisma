// Prisma 7：Prisma Client 產生到 src/generated/prisma（不進 git），連線網址寫在 prisma.config.ts
// 這一課的資料表已經建好（prisma/migrations），不用改 schema
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending
  paid
  preparing
  ready
  completed
  cancelled

  @@map("order_status")
}

model Customer {
  id     Int     @id @default(autoincrement())
  name   String
  email  String
  orders Order[]

  @@map("customers")
}

model Order {
  id            Int         @id @default(autoincrement())
  customerId    Int         @map("customer_id")
  customer      Customer    @relation(fields: [customerId], references: [id])
  total         Int
  status        OrderStatus @default(pending)
  receiptSentAt DateTime?   @map("receipt_sent_at") @db.Timestamptz(3) // 收據寄出的時間；null 代表還沒寄
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([customerId])
  @@map("orders")
}
