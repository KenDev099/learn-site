// Prisma 7：Prisma Client 產生到 src/generated/prisma（不進 git），連線網址寫在 prisma.config.ts
// 這一課的資料表已經建好（prisma/migrations），不用改 schema
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  price       Int
  stock       Int         @default(0)
  isAvailable Boolean     @default(true) @map("is_available")
  categoryId  Int         @map("category_id")
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]

  @@map("products")
}

model Customer {
  id     Int     @id @default(autoincrement())
  name   String
  phone  String  @unique
  orders Order[]

  @@map("customers")
}

model Order {
  id         Int         @id @default(autoincrement())
  customerId Int         @map("customer_id")
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  total      Int
  orderedAt  DateTime    @default(now()) @map("ordered_at") @db.Timestamptz(3)
  items      OrderItem[]

  @@index([customerId, orderedAt])
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Int     @map("unit_price") // 下單當下的單價（第 14 課）

  @@index([orderId])
  @@map("order_items")
}
